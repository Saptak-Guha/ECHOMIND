# ═══════════════════════════════════════════════════════════════════
# EchoMind Environment Variables
# ═══════════════════════════════════════════════════════════════════

# Application
APP_NAME=EchoMind
APP_VERSION=1.0.0
DEBUG=false

# PostgreSQL
POSTGRES_USER=echomind
POSTGRES_PASSWORD=echomind_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=echomind

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=echomind_neo4j

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chromadb

# FAISS
FAISS_INDEX_DIR=./data/faiss

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
# A single local-LLM request can run for minutes; a 30-minute token
# expired mid-session and logged the user out during a prediction.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── LLM Provider ───────────────────────────────────────────────────
# auto = try anthropic → openai → ollama, falling through on failure.
# Pin one with: anthropic | openai | ollama
LLM_PROVIDER=auto

# Ollama — local models, free, no API key. Install from https://ollama.com
# then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=180

# Anthropic (preferred provider; leave blank to run on local heuristics)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI (fallback provider; optional)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# File Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
